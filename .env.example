# =============================================================================
# TiDB Unified Agent — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================


# ── LLM Provider ──────────────────────────────────────────────────────────────
# Uncomment and set the key for whichever provider you are using.
# The agent currently uses the Anthropic SDK — swap the client in agent_ui.py
# and run_agent.py to switch providers.

# Anthropic (default)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
# OPENAI_API_KEY=sk-...

# Google Gemini
# GOOGLE_API_KEY=AIza...

# Azure OpenAI
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/


# ── TiDB Cloud ────────────────────────────────────────────────────────────────
# Get these from your TiDB Cloud console under Connect → Python:
# https://tidbcloud.com

TIDB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=<your-cluster-prefix>.root
TIDB_PASSWORD=<your-password>
TIDB_DATABASE=test

# Path to the TiDB CA certificate (download from TiDB Cloud console)
# macOS:  /Users/<you>/Downloads/isrgrootx1.pem
# Linux:  /home/<you>/isrgrootx1.pem
TIDB_SSL_CA=/path/to/isrgrootx1.pem


# ── Agent model routing ──────────────────────────────────────────────────────
# Override model selection per path. Defaults live in agent_tools.py.
# Uncomment + set to override. Set TIDB_AGENT_MODEL_EXPLORE=claude-opus-4-6 to
# test deep reasoning on novel fraud patterns; keep MODEL_SHORTCUT cheap because
# routed shortcuts run hot.
# TIDB_AGENT_MODEL_SHORTCUT=claude-haiku-4-5
# TIDB_AGENT_MODEL_EXPLORE=claude-sonnet-4-6
# TIDB_AGENT_MODEL_SUMMARY=claude-haiku-4-5


# ── Tenancy (REQUIRED) ───────────────────────────────────────────────────────
# The active tenant for a given run/process. Every domain query and every
# fact-layer call is scoped to this value; nothing is hardcoded, and scripts
# refuse to run un-scoped. Demo tenants: demo-bank-alpha, demo-bank-beta.
DEMO_TENANT_ID=demo-bank-alpha

# Acting agent identity for fact provenance (optional; the deployed Gateway
# interceptor is authoritative and may override this from the verified identity).
# FACT_LAYER_AGENT_ID=ag_fraud_detection.agent


# ── Governed fact layer (AgentCore Gateway) ──────────────────────────────────
# The standalone sibling service this repo calls over MCP for semantic memory
# (confirmed verdicts + recall). NOTE: at the time of this port the fact layer
# was NOT yet deployed, so there is no saved Gateway URL/ARN or Cognito client
# id to read — fill these from the fact layer's own deploy output.
FACT_LAYER_GATEWAY_URL=https://<gateway-id>.gateway.bedrock-agentcore.<region>.amazonaws.com/mcp
COGNITO_CLIENT_ID=<fact-layer dedicated app client id>
COGNITO_USERNAME=<test user whose token carries a tenant_id claim>
COGNITO_PASSWORD=<password>
AWS_REGION=eu-central-1

# For >1 tenant (needed to demo a cross-tenant Cedar deny), map each tenant to
# the Cognito identity whose token carries that tenant_id claim. Takes precedence
# over the single COGNITO_* vars above.
# FACT_LAYER_TENANT_CREDENTIALS={"demo-bank-alpha":{"client_id":"...","username":"...","password":"..."},"demo-bank-beta":{"client_id":"...","username":"...","password":"..."}}

# Predicate mapping. record_fact rejects predicates not in the fact layer's
# predicate_rule table; the deployed default set includes 'status' (scalar),
# which yields the corroborate/supersede/dispute semantics this port needs.
# Override ONLY if you have registered 'fraud_verdict' / 'liability_status' rows
# in the fact layer's predicate_rule.
# FACT_FRAUD_PREDICATE=status
# FACT_BETTING_PREDICATE=status


# ── Cognitive foundation routing tuning ──────────────────────────────────────
# Keep these COMMENTED unless you want to globally override the per-adapter
# calibration. Uncommenting them re-introduces a one-size-fits-all gate and
# undoes adapter-level tuning (e.g. fraud=0.45, betting=0.55 similarity).
# ROUTING_CONFIDENCE_GATE=0.85
# ROUTING_SIMILARITY_GATE=0.55

# NOTE: WRITE_CONTROL_MIN_CONFIDENCE is no longer read here — the write-control
# floor now lives SERVER-SIDE in the fact layer's record_fact. Set it there.
# NOTE: DEDUP_DISTANCE_THRESHOLD is gone — deduplication is retired in favour of
# canonical subject keys (see fact_layer_client.py).
